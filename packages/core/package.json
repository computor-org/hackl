{
  "name": "@hackl/core",
  "version": "0.3.2",
  "description": "Hackl shared local-AI agent backend (frontend-agnostic).",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0"
  }
}
