{
  "name": "hackl",
  "displayName": "Hackl",
  "description": "Hack with local AI.",
  "version": "0.0.1",
  "publisher": "computor-org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:computor-org/hackl.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:hackl.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hackl.chat",
        "title": "Chat with Hackl",
        "category": "Hackl",
        "icon": "$(comment-discussion)"
      }
    ],
    "keybindings": [
      {
        "command": "hackl.chat",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hackl.chat",
          "group": "navigation@50",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Hackl",
      "properties": {
        "hackl.endpoint": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API base URL. Leave empty to auto-discover llama.cpp on port 8080 or LM Studio on port 1234."
        },
        "hackl.maxOpenFileChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Maximum characters included per open file."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:coverage": "npm run compile && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=dist/chatClient.js --test-coverage-include=dist/context.js --test-coverage-include=dist/localServers.js --test-coverage-include=dist/prompt.js --test tests/*.test.cjs",
    "test:extension": "npm run compile && node scripts/run-vscode-smoke.mjs",
    "package:vsix": "npm run compile && vsce package",
    "smoke:openai": "npm run compile && node scripts/smoke-openai-compatible.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.5.4"
  }
}
