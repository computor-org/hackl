{
  "name": "hackl",
  "displayName": "Hackl",
  "description": "Hack with local AI.",
  "version": "0.0.24",
  "publisher": "computor-org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:computor-org/hackl.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hackl.chat",
    "onCommand:hackl.chatEditor",
    "onCommand:hackl.localServer.setup",
    "onCommand:hackl.localServer.manage",
    "onCommand:hackl.localServer.start",
    "onCommand:hackl.localServer.stop",
    "onCommand:hackl.localServer.restart",
    "onCommand:hackl.localServer.openLogs",
    "onView:hackl.chatView"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "hackl": "./dist/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "hackl.chat",
        "title": "Open Chat",
        "category": "Hackl",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hackl.chatEditor",
        "title": "Open Chat in Editor",
        "category": "Hackl",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hackl.localServer.setup",
        "title": "Set up local model",
        "category": "Hackl"
      },
      {
        "command": "hackl.localServer.manage",
        "title": "Manage local model",
        "category": "Hackl"
      },
      {
        "command": "hackl.localServer.start",
        "title": "Start local server",
        "category": "Hackl"
      },
      {
        "command": "hackl.localServer.stop",
        "title": "Stop local server",
        "category": "Hackl"
      },
      {
        "command": "hackl.localServer.restart",
        "title": "Restart local server",
        "category": "Hackl"
      },
      {
        "command": "hackl.localServer.openLogs",
        "title": "Show local model logs",
        "category": "Hackl"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "hackl",
          "title": "Hackl",
          "icon": "media/hackl.svg"
        }
      ]
    },
    "views": {
      "hackl": [
        {
          "id": "hackl.chatView",
          "type": "webview",
          "name": "Chat",
          "icon": "media/hackl.svg",
          "contextualTitle": "Hackl Chat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hackl.chat",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hackl.chat",
          "group": "navigation@50",
          "when": "editorTextFocus"
        },
        {
          "command": "hackl.chatEditor",
          "group": "navigation@51",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Hackl",
      "properties": {
        "hackl.endpoint": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API base URL. Leave empty to auto-discover llama.cpp on port 8080 or LM Studio on port 1234."
        },
        "hackl.maxToolFileChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Maximum characters returned by one read_file tool call."
        },
        "hackl.maxContextTokens": {
          "type": "number",
          "default": 32768,
          "minimum": 1024,
          "description": "Override for the model context window used by the token budget indicator. When unset, Hackl auto-detects from llama.cpp /props or LM Studio /api/v0/models and falls back to 32768."
        },
        "hackl.enableThinking": {
          "type": "boolean",
          "default": false,
          "description": "Allow model thinking/reasoning when the local OpenAI-compatible server supports this switch."
        },
        "hackl.debug": {
          "type": "boolean",
          "default": false,
          "description": "Write Hackl prompt and tool-loop diagnostics to the Hackl Debug output channel and the VS Code Extension Host debug console."
        },
        "hackl.localServer.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "When a local model has been configured, start the llama.cpp server automatically on activation and stop it on deactivation."
        },
        "hackl.localServer.port": {
          "type": "number",
          "default": 8080,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Preferred port for the managed llama.cpp server. If busy, Hackl scans up to port+19."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "hackl.localModel",
        "title": "Set up a local model with Hackl",
        "description": "Hackl installs llama.cpp, downloads a curated GGUF, and tunes the server for your hardware. No keys, no cloud.",
        "steps": [
          {
            "id": "hackl.walkthrough.setup",
            "title": "Detect hardware and pick a model",
            "description": "Open the setup wizard. Hackl probes your GPU, RAM, and platform, then recommends one of five curated models.\n\n[Open setup](command:hackl.localServer.setup)",
            "media": { "markdown": "media/walkthrough-setup.md" },
            "completionEvents": ["onCommand:hackl.localServer.setup"]
          },
          {
            "id": "hackl.walkthrough.chat",
            "title": "Start chatting locally",
            "description": "Open the Hackl sidebar and ask about your code. Everything stays on your machine.\n\n[Open chat](command:hackl.chat)",
            "media": { "markdown": "media/walkthrough-setup.md" },
            "completionEvents": ["onCommand:hackl.chat"]
          },
          {
            "id": "hackl.walkthrough.manage",
            "title": "Manage the server later",
            "description": "Start, stop, or swap models any time from the manage panel.\n\n[Open manage panel](command:hackl.localServer.manage)",
            "media": { "markdown": "media/walkthrough-setup.md" },
            "completionEvents": ["onCommand:hackl.localServer.manage"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs tests/**/*.test.cjs",
    "test:ui": "npm run compile && node scripts/run-webview-ui-smoke.mjs",
    "test:coverage": "npm run compile && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=dist/chatClient.js --test-coverage-include=dist/context.js --test-coverage-include=dist/localServers.js --test-coverage-include=dist/prompt.js --test tests/*.test.cjs",
    "test:extension": "npm run compile && node scripts/run-vscode-smoke.mjs",
    "package:vsix": "npm run compile && vsce package",
    "smoke:openai": "npm run compile && node scripts/smoke-openai-compatible.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.106.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "typescript": "^5.5.4"
  }
}
