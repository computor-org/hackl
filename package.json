{
  "name": "hackl",
  "displayName": "Hackl",
  "description": "Hack with local AI.",
  "version": "0.0.13",
  "publisher": "computor-org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:computor-org/hackl.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:hackl.chat",
    "onCommand:hackl.chatEditor",
    "onCommand:hackl.toggleAutocomplete",
    "onView:hackl.chatView",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hackl.chat",
        "title": "Open Chat",
        "category": "Hackl",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hackl.chatEditor",
        "title": "Open Chat in Editor",
        "category": "Hackl",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hackl.toggleAutocomplete",
        "title": "Toggle Inline Autocomplete",
        "category": "Hackl",
        "icon": "$(sparkle)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "hackl",
          "title": "Hackl",
          "icon": "media/hackl.svg"
        }
      ]
    },
    "views": {
      "hackl": [
        {
          "id": "hackl.chatView",
          "type": "webview",
          "name": "Chat",
          "icon": "media/hackl.svg",
          "contextualTitle": "Hackl Chat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hackl.chat",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hackl.chat",
          "group": "navigation@50",
          "when": "editorTextFocus"
        },
        {
          "command": "hackl.chatEditor",
          "group": "navigation@51",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Hackl",
      "properties": {
        "hackl.endpoint": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API base URL. Leave empty to auto-discover llama.cpp on port 8080 or LM Studio on port 1234."
        },
        "hackl.maxToolFileChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Maximum characters returned by one read_file tool call."
        },
        "hackl.maxContextTokens": {
          "type": "number",
          "default": 32768,
          "minimum": 1024,
          "description": "Override for the model context window used by the token budget indicator. When unset, Hackl auto-detects from llama.cpp /props or LM Studio /api/v0/models and falls back to 32768."
        },
        "hackl.enableThinking": {
          "type": "boolean",
          "default": false,
          "description": "Allow model thinking/reasoning when the local OpenAI-compatible server supports this switch."
        },
        "hackl.autocomplete.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable inline ghost-text autocomplete (FIM). Toggle from the Hackl AC status-bar icon. Automatically inactive when the loaded model has no FIM tokens."
        },
        "hackl.autocomplete.endpoint": {
          "type": "string",
          "default": "",
          "description": "Override the endpoint for autocomplete requests (OpenAI-style base URL or llama.cpp root). When empty, autocomplete falls back to hackl.endpoint (with autodiscovery)."
        },
        "hackl.autocomplete.model": {
          "type": "string",
          "default": "",
          "description": "Model alias to send for autocomplete. When empty, uses the chat target's model."
        },
        "hackl.autocomplete.maxTokens": {
          "type": "number",
          "default": 64,
          "minimum": 8,
          "description": "Maximum tokens to predict per inline suggestion."
        },
        "hackl.autocomplete.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "Debounce in milliseconds after the last keystroke before issuing an autocomplete request."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:ui": "npm run compile && node scripts/run-webview-ui-smoke.mjs",
    "test:coverage": "npm run compile && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=dist/chatClient.js --test-coverage-include=dist/context.js --test-coverage-include=dist/localServers.js --test-coverage-include=dist/prompt.js --test-coverage-include=dist/fimDetect.js --test-coverage-include=dist/fimClient.js --test tests/*.test.cjs",
    "test:extension": "npm run compile && node scripts/run-vscode-smoke.mjs",
    "package:vsix": "npm run compile && vsce package",
    "smoke:openai": "npm run compile && node scripts/smoke-openai-compatible.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.106.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "typescript": "^5.5.4"
  }
}
