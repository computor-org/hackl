{
  "name": "hackl",
  "displayName": "Hackl",
  "description": "Hack local-first.",
  "version": "0.0.67",
  "enabledApiProposals": [
    "commentReveal"
  ],
  "publisher": "computor-org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:computor-org/hackl.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hackl.chat",
        "title": "Open Chat",
        "category": "Hackl",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hackl.checkLocalServer",
        "title": "Check Local Server",
        "category": "Hackl"
      },
      {
        "command": "hackl.refreshEndpoint",
        "title": "Refresh Endpoint",
        "category": "Hackl"
      },
      {
        "command": "hackl.traceAnnotationRanges",
        "title": "Trace Annotation Ranges",
        "category": "Hackl"
      },
      {
        "command": "hackl.replyToAnnotationThread",
        "title": "Submit",
        "category": "Hackl",
        "icon": "$(arrow-up)"
      },
      {
        "command": "hackl.addAnnotationNote",
        "title": "Add Annotation Note",
        "category": "Hackl",
        "icon": "$(comment-add)"
      },
      {
        "command": "hackl.deleteAnnotationThread",
        "title": "Delete Annotation Thread",
        "category": "Hackl",
        "icon": "$(trash)"
      },
      {
        "command": "hackl.resolveAnnotationThread",
        "title": "Resolve",
        "category": "Hackl",
        "icon": "$(check)"
      },
      {
        "command": "hackl.addSelectionToContext",
        "title": "Add Selection",
        "category": "Hackl",
        "icon": "$(add)"
      },
      {
        "command": "hackl.addCurrentFileToContext",
        "title": "Add Current File",
        "category": "Hackl",
        "icon": "$(file-code)"
      },
      {
        "command": "hackl.addMarkdownSectionToContext",
        "title": "Add Markdown Section",
        "category": "Hackl"
      },
      {
        "command": "hackl.addStagedChangesToContext",
        "title": "Add Staged Changes",
        "category": "Hackl"
      },
      {
        "command": "hackl.addLastCommitToContext",
        "title": "Add Last Commit to Context",
        "category": "Hackl"
      },
      {
        "command": "hackl.clearContext",
        "title": "Clear Context",
        "category": "Hackl"
      },
      {
        "command": "hackl.clearAnnotations",
        "title": "Clear Annotations",
        "category": "Hackl"
      },
      {
        "command": "hackl.discardLastAnnotations",
        "title": "Discard Last Annotations Batch",
        "category": "Hackl"
      },
      {
        "command": "hackl.reviewStagedChanges",
        "title": "Review Staged Changes",
        "category": "Hackl"
      },
      {
        "command": "hackl.revealTarget",
        "title": "Reveal Target",
        "category": "Hackl"
      },
      {
        "command": "hackl.selectBackend",
        "title": "Select Backend",
        "category": "Hackl"
      },
      {
        "command": "hackl.codexLogin",
        "title": "Log in to Codex",
        "category": "Hackl"
      },
      {
        "command": "hackl.toggleAutocomplete",
        "title": "Toggle Inline Autocomplete",
        "category": "Hackl",
        "icon": "$(sparkle)"
      },
      {
        "command": "hackl.dismissFocusedEmptyComment",
        "title": "Dismiss Empty Annotation",
        "category": "Hackl"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "hackl",
          "title": "Hackl",
          "icon": "media/hackl.svg"
        }
      ]
    },
    "views": {
      "hackl": [
        {
          "id": "hackl.chatView",
          "type": "webview",
          "name": "Chat",
          "icon": "media/hackl.svg",
          "contextualTitle": "Hackl Chat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hackl.chat",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "hackl.addSelectionToContext",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "hackl.discardLastAnnotations",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z"
      },
      {
        "command": "hackl.dismissFocusedEmptyComment",
        "key": "escape",
        "when": "commentEditorFocused && commentIsEmpty"
      },
      {
        "command": "editor.action.inlineSuggest.acceptNextWord",
        "key": "alt+right",
        "mac": "alt+right",
        "when": "inlineSuggestionVisible && !editorReadonly"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "hackl.replyToAnnotationThread",
          "when": "false"
        },
        {
          "command": "hackl.deleteAnnotationThread",
          "when": "false"
        },
        {
          "command": "hackl.resolveAnnotationThread",
          "when": "false"
        },
        {
          "command": "hackl.revealTarget",
          "when": "false"
        },
        {
          "command": "hackl.dismissFocusedEmptyComment",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "hackl.chat",
          "group": "navigation@50",
          "when": "editorTextFocus"
        },
        {
          "command": "hackl.addSelectionToContext",
          "group": "navigation@52",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "hackl.addCurrentFileToContext",
          "group": "navigation@53",
          "when": "editorTextFocus"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "hackl.replyToAnnotationThread",
          "group": "inline@1",
          "when": "commentController == hackl.annotations"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "hackl.resolveAnnotationThread",
          "group": "inline@1",
          "when": "commentController == hackl.annotations && commentThread == hackl.annotation.open"
        }
      ],
      "scm/title": [
        {
          "command": "hackl.addStagedChangesToContext",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Hackl",
      "properties": {
        "hackl.endpoint": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API base URL. Leave empty to auto-discover llama.cpp on port 8080 or LM Studio on port 1234."
        },
        "hackl.model": {
          "type": "string",
          "default": "",
          "description": "Chat/agent model id for the local OpenAI-compatible endpoint. Leave empty to use the first model the endpoint reports. Set this when the endpoint serves several models (e.g. a separate chat model from the autocomplete/FIM model). Set automatically when picking a model from the chat dropdown."
        },
        "hackl.maxToolFileChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Maximum characters returned by one read_file tool call."
        },
        "hackl.maxContextTokens": {
          "type": "number",
          "default": 32768,
          "minimum": 1024,
          "description": "Override for the model context window used by the token budget indicator. When unset, Hackl auto-detects from llama.cpp /props or LM Studio /api/v0/models and falls back to 32768."
        },
        "hackl.enableThinking": {
          "type": "boolean",
          "default": false,
          "description": "Allow model thinking/reasoning when the local OpenAI-compatible server supports this switch."
        },
        "hackl.reasoningBudget": {
          "type": "number",
          "default": 4096,
          "minimum": -1,
          "description": "Token cap on hidden reasoning when thinking is enabled, sent per request as thinking_budget_tokens. Stops a thinking model from looping through the whole turn in agent mode. -1 is unrestricted, 0 ends thinking immediately. llama.cpp honors this only when its server was started without --reasoning-budget; otherwise pass --reasoning-budget on the server."
        },
        "hackl.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline FIM autocomplete. On by default. When hackl.autocomplete.endpoint is empty, autocomplete reuses the chat endpoint (hackl.endpoint or an auto-discovered local server) and the model it has loaded, so one Qwen model serves both chat and completion."
        },
        "hackl.autocomplete.endpoint": {
          "type": "string",
          "default": "",
          "description": "Optional dedicated llama.cpp-compatible endpoint for autocomplete requests. Accepts a /v1 base or server root. Leave empty to reuse the chat endpoint for FIM when its model supports infill tokens (the Qwen line does, plain Gemma does not). Set this only to run a separate FIM model."
        },
        "hackl.autocomplete.model": {
          "type": "string",
          "default": "",
          "description": "Model alias for a dedicated autocomplete endpoint. Applies only when hackl.autocomplete.endpoint is set; it is ignored when autocomplete reuses the chat endpoint, which always uses the chat endpoint's loaded model. Remove this when you remove the autocomplete endpoint."
        },
        "hackl.autocomplete.maxTokens": {
          "type": "number",
          "default": 48,
          "minimum": 8,
          "description": "Maximum tokens to predict per inline suggestion."
        },
        "hackl.autocomplete.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Debounce after the last keystroke before requesting autocomplete."
        },
        "hackl.autocomplete.multiLine": {
          "type": "boolean",
          "default": false,
          "description": "Allow multi-line inline completions. When off, Hackl stops at the first newline."
        },
        "hackl.autocomplete.maxPredictMs": {
          "type": "number",
          "default": 400,
          "minimum": 50,
          "description": "Server-side prediction time budget in milliseconds for one autocomplete request."
        },
        "hackl.setupProfile": {
          "type": "string",
          "enum": [
            "auto",
            "lmstudio",
            "llamacpp",
            "ollama"
          ],
          "default": "auto",
          "description": "Preferred backend for setup-guide ordering only. Hackl never starts a server; this just decides which recipe is foregrounded in the Setup view."
        },
        "hackl.debug": {
          "type": "boolean",
          "default": false,
          "description": "Write Hackl prompt and tool-loop diagnostics to the Hackl Debug output channel and the VS Code Extension Host debug console."
        },
        "hackl.persistSessions": {
          "type": "boolean",
          "default": true,
          "description": "Persist completed Hackl sessions (when annotations are requested) as JSON files in VS Code extension storage."
        },
        "hackl.codex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Codex CLI backend. When enabled, Hackl auto-detects `codex` on PATH and offers it alongside the local OpenAI-compatible backend."
        },
        "hackl.codex.command": {
          "type": "string",
          "default": "codex",
          "description": "Command used to invoke the Codex CLI. Override if codex is installed at a non-standard location."
        },
        "hackl.codex.model": {
          "type": "string",
          "default": "",
          "description": "Last-selected Codex model. Set automatically when picking a model from the chat dropdown."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "hackl.connect",
        "title": "Connect Hackl to a local model",
        "description": "Hackl talks to your local OpenAI-compatible server. Pick a path, start it yourself, point Hackl at it.",
        "steps": [
          {
            "id": "hackl.walkthrough.pickServer",
            "title": "Pick a server",
            "description": "LM Studio is the easy path. llama.cpp is the expert path. Ollama works too.\n\n[LM Studio](command:hackl.openSetupDoc?%5B%22lmstudio%22%5D) · [llama.cpp](command:hackl.openSetupDoc?%5B%22llamacpp%22%5D) · [Ollama](command:hackl.openSetupDoc?%5B%22ollama%22%5D)\n\nUsing Codex instead? [Log in to Codex](command:hackl.codexLogin), then [Select Backend](command:hackl.selectBackend).",
            "media": {
              "markdown": "media/setup-tutorial.md"
            },
            "completionEvents": [
              "onCommand:hackl.openSetupDoc"
            ]
          },
          {
            "id": "hackl.walkthrough.setEndpoint",
            "title": "Set the endpoint",
            "description": "Once your server is running, point Hackl at it.\n\n[Edit settings](command:workbench.action.openSettings?%22hackl.endpoint%22) · [Check connection](command:hackl.checkLocalServer)",
            "media": {
              "markdown": "media/setup-tutorial.md"
            },
            "completionEvents": [
              "onCommand:hackl.checkLocalServer"
            ]
          },
          {
            "id": "hackl.walkthrough.chat",
            "title": "Open chat",
            "description": "Start chatting locally.\n\n[Open chat](command:hackl.chat)",
            "media": {
              "markdown": "media/setup-tutorial.md"
            },
            "completionEvents": [
              "onCommand:hackl.chat"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs tests/**/*.test.cjs",
    "test:ui": "npm run compile && node scripts/run-webview-ui-smoke.mjs",
    "test:coverage": "npm run compile && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=dist/chatClient.js --test-coverage-include=dist/context.js --test-coverage-include=dist/localServers.js --test-coverage-include=dist/prompt.js --test tests/*.test.cjs",
    "test:extension": "npm run compile && node scripts/run-vscode-smoke.mjs",
    "package:vsix": "npm run compile && vsce package",
    "smoke:openai": "npm run compile && node scripts/smoke-openai-compatible.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.106.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "typescript": "^5.5.4"
  }
}
